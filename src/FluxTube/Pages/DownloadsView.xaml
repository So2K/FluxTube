<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluxTube.Pages.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,8,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,16,10">
            <TextBlock Text="Загрузки" FontSize="26" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <TextBox x:Name="Filter" PlaceholderText="Искать в скачанном" Width="260" TextChanged="Filter_TextChanged" />
                <Button Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Папка" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" PlaceholderText="Вставьте ссылку: YouTube, TikTok, Instagram, VK, Twitch, … (yt-dlp понимает 1800+ сайтов)" KeyDown="UrlBox_KeyDown" />
            <ComboBox x:Name="QualityBox" Grid.Column="1" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="Add_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock Text="Скачать" />
                </StackPanel>
            </Button>
        </Grid>
        <ListView x:Name="List" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick" Padding="0,0,16,40">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="14" Padding="0,6" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid CornerRadius="8" Height="99" Background="{StaticResource ThumbPlaceholderBrush}">
                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Channel}" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" MaxLines="2" />
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource BrandBrush}"
                                         Visibility="{Binding IsActive, Converter={StaticResource VisibleIf}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Tag="{Binding}" Click="Play_Click" ToolTipService.ToolTip="Смотреть" Visibility="{Binding IsDone, Converter={StaticResource VisibleIf}}">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                            </Button>
                            <Button Tag="{Binding}" Click="Reveal_Click" ToolTipService.ToolTip="Показать в папке" Visibility="{Binding IsDone, Converter={StaticResource VisibleIf}}">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                            </Button>
                            <Button Tag="{Binding}" Click="Cancel_Click" ToolTipService.ToolTip="Остановить" Visibility="{Binding IsActive, Converter={StaticResource VisibleIf}}">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                            </Button>
                            <Button Tag="{Binding}" Click="Retry_Click" ToolTipService.ToolTip="Повторить">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Tag="{Binding}" Click="Delete_Click" ToolTipService.ToolTip="Удалить (запись и файл)">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
