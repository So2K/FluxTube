<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluxTube.Pages.WatchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Layout" Padding="20,4,0,0" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SideCol" Width="410" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="MainCol">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- the native mpv window is positioned exactly over this border -->
            <Border x:Name="VideoBox" Background="Black" />

            <ScrollViewer x:Name="InfoScroll" Grid.Row="1" Padding="0,14,10,30" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="Avatar" Width="42" Height="42" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <HyperlinkButton x:Name="ChannelLink" Padding="0" FontWeight="SemiBold" FontSize="15" Click="Channel_Click" Foreground="White" />
                            <TextBlock x:Name="SubsText" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Border CornerRadius="18" Background="#1FFFFFFF" Padding="14,0" Height="36">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8E1;" FontSize="15" />
                                        <TextBlock x:Name="LikesText" Text="—" />
                                    </StackPanel>
                                    <Rectangle Width="1" Height="18" Fill="#44FFFFFF" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="Дизлайки (Return YouTube Dislike)">
                                        <FontIcon Glyph="&#xE8E0;" FontSize="15" />
                                        <TextBlock x:Name="DislikesText" Text="—" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <SplitButton x:Name="DownloadButton" Click="Download_Click" CornerRadius="18" Height="36">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="15" />
                                    <TextBlock x:Name="DownloadText" Text="Скачать" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <MenuFlyout x:Name="QualityMenu" Placement="Bottom" />
                                </SplitButton.Flyout>
                            </SplitButton>
                            <DropDownButton CornerRadius="18" Height="36" ToolTipService.ToolTip="Скорость">
                                <TextBlock x:Name="SpeedText" Text="1×" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="SpeedMenu" Placement="Bottom" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton CornerRadius="18" Height="36" ToolTipService.ToolTip="Качество воспроизведения">
                                <TextBlock x:Name="PlayQualityText" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="PlayQualityMenu" Placement="Bottom" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button CornerRadius="18" Height="36" Click="More_Click" ToolTipService.ToolTip="Ещё">
                                <FontIcon Glyph="&#xE712;" FontSize="15" />
                            </Button>
                            <ToggleButton x:Name="TheaterToggle" CornerRadius="18" Height="36" Click="Theater_Click" ToolTipService.ToolTip="Театральный режим">
                                <FontIcon Glyph="&#xE9A6;" FontSize="15" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                    <Border CornerRadius="12" Background="#14FFFFFF" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="StatsText" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="DescText" TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxLines="4" FontSize="13.5" />
                            <HyperlinkButton x:Name="DescToggle" Content="Ещё" Padding="0" Click="DescToggle_Click" />
                        </StackPanel>
                    </Border>
                    <InfoBar x:Name="Message" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="SidePanel" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,16,6">
                <TextBlock Text="Похожие" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="AutoplaySwitch" HorizontalAlignment="Right" OnContent="Автовоспроизведение" OffContent="Автовоспроизведение"
                              Toggled="Autoplay_Toggled" MinWidth="0" />
            </Grid>
            <ProgressRing x:Name="Busy" Grid.Row="1" IsActive="True" VerticalAlignment="Top" Margin="0,30,0,0" />
            <ListView x:Name="Related" Grid.Row="1" ItemTemplate="{StaticResource VideoRowTemplate}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Related_ItemClick"
                      Padding="0,0,8,30" />
        </Grid>
    </Grid>
</UserControl>
