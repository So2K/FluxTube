<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluxTube.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluxTube">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid x:Name="TitleBar" Padding="8,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Width="40" Height="36" Padding="0" Background="Transparent" BorderThickness="0"
                    Click="Back_Click" ToolTipService.ToolTip="Назад (Alt+←)" IsEnabled="False">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Width="26" Height="18" CornerRadius="5" Background="{StaticResource BrandBrush}">
                    <FontIcon Glyph="&#xF5B0;" FontSize="10" Foreground="White" />
                </Border>
                <TextBlock Text="FluxTube" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="3" Width="560" VerticalAlignment="Center"
                            PlaceholderText="Поиск или ссылка (YouTube, TikTok, …)" QueryIcon="Find"
                            TextChanged="Search_TextChanged" QuerySubmitted="Search_QuerySubmitted"
                            GotFocus="Search_GotFocus" LostFocus="Search_LostFocus" />
            <Button x:Name="AccountButton" Grid.Column="5" Height="36" Padding="10,0" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="AccountIcon" Glyph="&#xE77B;" FontSize="16" />
                    <TextBlock x:Name="AccountText" Text="Войти" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="AccountMenu" Opening="AccountMenu_Opening" />
                </Button.Flyout>
            </Button>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True" IsPaneToggleButtonVisible="True" OpenPaneLength="230"
                        SelectionChanged="Nav_SelectionChanged" ItemInvoked="Nav_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="home"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Подписки" Tag="subs"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Смотреть позже" Tag="wl"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Понравившиеся" Tag="liked"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8E1;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="История просмотров" Tag="history"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Что я видел" Tag="seen"><NavigationViewItem.Icon><FontIcon Glyph="&#xE890;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Загрузки" Tag="downloads"><NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="TikTok" Tag="tiktok"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B2;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                <Border x:Name="MiniHost" Width="400" Height="225" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,18,14" CornerRadius="10" Background="Black" Visibility="Collapsed" />
                <InfoBar x:Name="Toast" IsOpen="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="700" />
            </Grid>
        </NavigationView>

        <!-- now playing -->
        <Grid x:Name="NowPlaying" Grid.Row="2" Height="64" Padding="14,0" ColumnSpacing="12" Visibility="Collapsed"
              Background="#E6141418" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="80" Height="45" CornerRadius="6">
                <Image x:Name="NpThumb" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="NpTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NpChannel" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    <ProgressBar x:Name="NpProgress" Grid.Column="1" Maximum="1" VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}" />
                    <TextBlock x:Name="NpTime" Grid.Column="2" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Click="NpBack10_Click" ToolTipService.ToolTip="-10 с" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xED3C;" FontSize="16" /></Button>
                <Button Click="NpPause_Click" ToolTipService.ToolTip="Пауза" Background="Transparent" BorderThickness="0"><FontIcon x:Name="NpPauseIcon" Glyph="&#xE769;" FontSize="16" /></Button>
                <Button Click="NpFwd10_Click" ToolTipService.ToolTip="+10 с" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xED3D;" FontSize="16" /></Button>
                <ToggleButton x:Name="NpMiniToggle" Click="NpMini_Click" ToolTipService.ToolTip="Мини-плеер" IsChecked="True" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE944;" FontSize="16" /></ToggleButton>
                <Button Click="NpOpen_Click" ToolTipService.ToolTip="Развернуть" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE740;" FontSize="16" /></Button>
                <Button Click="NpClose_Click" ToolTipService.ToolTip="Закрыть" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE711;" FontSize="16" /></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
