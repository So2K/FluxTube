<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FluxTube.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluxTube.UI"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="BrandColor">#FFFF3355</Color>
            <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFA8A8B3" />
            <SolidColorBrush x:Key="BadgeBrush" Color="#D9000000" />
            <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="#FF1E1E24" />

            <ui:VisibleIfConverter x:Key="VisibleIf" />
            <ui:VisibleIfNotConverter x:Key="VisibleIfNot" />

            <!-- big card for grids -->
            <DataTemplate x:Key="VideoCardTemplate">
                <Grid Width="318" Padding="0,0,0,14" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid CornerRadius="10" Height="179" Background="{StaticResource ThumbPlaceholderBrush}">
                        <Image x:Name="Thumb" Stretch="UniformToFill" />
                        <Border Background="{StaticResource BadgeBrush}" CornerRadius="4" Padding="5,1,5,2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                Visibility="{Binding HasDuration, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding DurationBadge}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <ProgressBar Value="{Binding Progress}" Maximum="1" VerticalAlignment="Bottom" MinHeight="3"
                                     Foreground="{StaticResource BrandBrush}" Background="#66FFFFFF" CornerRadius="0"
                                     Visibility="{Binding Progress, Converter={StaticResource VisibleIf}}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture Width="34" Height="34" VerticalAlignment="Top" ProfilePicture="{Binding AvatarUrl}"
                                       DisplayName="{Binding Channel}"
                                       Visibility="{Binding AvatarUrl, Converter={StaticResource VisibleIf}}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
                            <TextBlock Text="{Binding ChannelMeta}" FontSize="12.5" Foreground="{StaticResource SubtleTextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- compact row for side lists -->
            <DataTemplate x:Key="VideoRowTemplate">
                <Grid ColumnSpacing="10" Padding="0,4" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid CornerRadius="8" Height="94" Background="{StaticResource ThumbPlaceholderBrush}">
                        <Image x:Name="Thumb" Stretch="UniformToFill" />
                        <Border Background="{StaticResource BadgeBrush}" CornerRadius="4" Padding="4,0,4,1"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                Visibility="{Binding HasDuration, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding DurationBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <ProgressBar Value="{Binding Progress}" Maximum="1" VerticalAlignment="Bottom" MinHeight="3"
                                     Foreground="{StaticResource BrandBrush}" Background="#66FFFFFF" CornerRadius="0"
                                     Visibility="{Binding Progress, Converter={StaticResource VisibleIf}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Channel}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
